#!/usr/bin/env node
/*
 * [openharmony 适配] @vscode/ripgrep 的 shim。
 *
 * 鸿蒙上没有 @vscode/ripgrep-openharmony-arm64 平台包，dsh 的 grep / glob 工具会直接报
 * `ripgrep launch failed`。这个脚本顶替真正的 rg，只实现 @deepseek-ai/dsh-tool-fs-search
 * 实际用到的两种调用：
 *
 *   glob:  rg --files --glob=<pat> --glob=!<vcs> --sort=modified --no-ignore --hidden [-- <path>]
 *   grep:  rg --json --regexp=<pat> [--glob=<inc>] [-- <path>]
 *
 * 输出协议：
 *   glob -> 每行一个路径（相对给定根）
 *   grep -> 每行一个 JSON（NDJSON），只发 type:"match"，字段取
 *           data.path.text / data.line_number / data.lines.text
 * 退出码：0 有结果 / 1 无结果 / 2 用法错误。
 *
 * ⚠ 只覆盖 dsh 用到的子集；dsh 升级若改了 argv，这里要跟着改。
 */
'use strict';

const fs = require('node:fs');
const path = require('node:path');

function parseArgv(argv) {
  const o = {
    files: false, json: false, regexp: '', hidden: false, noIgnore: false,
    sortModified: false, includes: [], excludes: [], roots: []
  };
  let after = false;
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (after) { o.roots.push(a); continue; }
    if (a === '--') { after = true; continue; }
    if (a === '--files') { o.files = true; continue; }
    if (a === '--json') { o.json = true; continue; }
    if (a === '--hidden') { o.hidden = true; continue; }
    if (a === '--no-ignore') { o.noIgnore = true; continue; }
    if (a === '--no-config' || a === '--no-messages') { continue; }
    if (a === '--sort') { o.sortModified = true; i++; continue; }
    if (a === '--sort=modified') { o.sortModified = true; continue; }
    if (a.startsWith('--glob=')) {
      const v = a.slice(7);
      if (v.startsWith('!')) { o.excludes.push(v.slice(1)); } else { o.includes.push(v); }
      continue;
    }
    if (a === '--glob') {
      const v = argv[++i] || '';
      if (v.startsWith('!')) { o.excludes.push(v.slice(1)); } else { o.includes.push(v); }
      continue;
    }
    if (a.startsWith('--regexp=')) { o.regexp = a.slice(9); continue; }
    if (a === '--regexp' || a === '-e') { o.regexp = argv[++i] || ''; continue; }
    if (a.startsWith('-')) { continue; } // 其余 flag 一律忽略（超出子集）
    o.roots.push(a);
  }
  if (o.roots.length === 0) { o.roots.push('.'); }
  return o;
}

/** glob -> RegExp：支持 *、**、? */
function globToRegExp(pat) {
  const s = String(pat).replace(/\\/g, '/');
  let re = '';
  for (let i = 0; i < s.length; i++) {
    const c = s[i];
    if (c === '*') {
      if (s[i + 1] === '*') {
        if (s[i + 2] === '/') { re += '(?:.*/)?'; i += 2; } else { re += '.*'; i += 1; }
      } else { re += '[^/]*'; }
    } else if (c === '?') { re += '[^/]'; }
    else if ('.+^$(){}|[]'.indexOf(c) >= 0) { re += '\\' + c; }
    else { re += c; }
  }
  return new RegExp('^' + re + '$');
}

function makeMatcher(pats) {
  const res = pats.map(globToRegExp);
  return function (rel) {
    const base = path.posix.basename(rel);
    for (const r of res) {
      if (r.test(rel)) { return true; }
      if (r.test(base)) { return true; }
    }
    return false;
  };
}

/** 是否像文本（头 8KB 无 NUL） */
function looksText(buf) {
  const n = Math.min(buf.length, 8192);
  for (let i = 0; i < n; i++) { if (buf[i] === 0) { return false; } }
  return true;
}

/** 收集文件（跳过符号链接，避免环） */
function walk(root, out) {
  let st;
  try { st = fs.lstatSync(root); } catch (e) { return; }
  if (st.isSymbolicLink()) { return; }
  if (st.isDirectory()) {
    let names;
    try { names = fs.readdirSync(root); } catch (e) { return; }
    for (const n of names) { walk(path.join(root, n), out); }
    return;
  }
  if (st.isFile()) { out.push({ full: root, mtimeMs: st.mtimeMs }); }
}

function main() {
  const o = parseArgv(process.argv.slice(2));
  if (o.regexp === '' && !o.files) {
    process.stderr.write('rg-shim: 需要 --files 或 --regexp\n');
    process.exit(2);
  }

  const incMatch = o.includes.length > 0 ? makeMatcher(o.includes) : null;
  const excMatch = o.excludes.length > 0 ? makeMatcher(o.excludes) : null;

  const files = [];
  for (const r of o.roots) { walk(r, files); }
  if (o.sortModified) { files.sort((a, b) => b.mtimeMs - a.mtimeMs); }

  let any = false;

  if (o.files) {
    // glob 模式
    for (const f of files) {
      const rel = path.relative(process.cwd(), f.full) || f.full;
      const posixRel = rel.split(path.sep).join('/');
      if (excMatch !== null && excMatch(posixRel)) { continue; }
      if (incMatch !== null && !incMatch(posixRel)) { continue; }
      process.stdout.write(posixRel + '\n');
      any = true;
    }
  } else {
    // grep 模式：NDJSON
    let re;
    try { re = new RegExp(o.regexp); } catch (e) { re = new RegExp(o.regexp.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')); }
    for (const f of files) {
      const rel = path.relative(process.cwd(), f.full) || f.full;
      const posixRel = rel.split(path.sep).join('/');
      if (excMatch !== null && excMatch(posixRel)) { continue; }
      if (incMatch !== null && !incMatch(posixRel)) { continue; }
      let buf;
      try { buf = fs.readFileSync(f.full); } catch (e) { continue; }
      if (!looksText(buf)) { continue; }
      const lines = buf.toString('utf8').split('\n');
      for (let i = 0; i < lines.length; i++) {
        let line = lines[i];
        if (line.endsWith('\r')) { line = line.slice(0, -1); }
        re.lastIndex = 0;
        if (re.test(line)) {
          process.stdout.write(JSON.stringify({
            type: 'match',
            data: {
              path: { text: posixRel },
              line_number: i + 1,
              lines: { text: line + '\n' }
            }
          }) + '\n');
          any = true;
        }
      }
    }
  }

  process.exit(any ? 0 : 1);
}

main();
